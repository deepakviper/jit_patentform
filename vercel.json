{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/dist/assets/$1"
    },
    {
      "source": "/(.*\\.(?:jpeg|jpg|png|gif|svg|ico|js|css))",
      "destination": "/dist/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/dist/index.html"
    }
  ]
}
